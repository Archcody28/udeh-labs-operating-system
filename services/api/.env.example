# Placeholders only — never commit real credentials.
NODE_ENV=development
PORT=3001
# Dev database (docker-compose default):
DATABASE_URL=postgresql://udehlabs:udehlabs_dev@localhost:5432/udehlabs_dev
# Test database (CI service):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/udehlabs_test
PGPOOL_MAX=10
# Cookie Secure flag (true in production behind TLS; false for local http):
COOKIE_SECURE=false
# Password policy: enforced server-side, 12..256 chars (see docs/architecture/session-security.md).
# No signing secrets needed: sessions are opaque server-side rows, not JWTs.
# Production hardening (TLS, Postgres least-privilege roles, shared rate-limit
# store, MFA/TOTP verifier) is documented, not configured here.
