# Placeholders only — never commit real credentials.
NODE_ENV=development
PORT=3001
# Dev database (docker-compose default):
DATABASE_URL=postgresql://udehlabs:udehlabs_dev@localhost:5432/udehlabs_dev
# Test database (CI service):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/udehlabs_test
PGPOOL_MAX=10
# Notification dispatch worker (Phase 14). Set NOTIFICATION_WORKER_ENABLED=false
# to run the dispatcher as a separate deployment instead of in-process.
# NOTIFICATION_WORKER_ENABLED=true
# NOTIFICATION_WORKER_INTERVAL_MS=1000
# NOTIFICATION_WORKER_BATCH_SIZE=25
# Cookie Secure flag (true in production behind TLS; false for local http):
COOKIE_SECURE=false
# Password policy: enforced server-side, 12..256 chars (see docs/architecture/session-security.md).
# No signing secrets needed: sessions are opaque server-side rows, not JWTs.
# Production hardening (TLS, Postgres least-privilege roles, shared rate-limit
# store, MFA/TOTP verifier) is documented, not configured here.

# ---------------------------------------------------------------------------
# Phase 15 Observability
# ---------------------------------------------------------------------------
# Structured log level: debug | info | warn | error (default: info).
# LOG_LEVEL=info
# Log sink failure threshold: if the sink throws more than this many times
# in a row, logging continues fail-open (errors swallowed). Default: 5.
# LOG_SINK_FAILURE_THRESHOLD=5
# Metrics collection interval in milliseconds (default: 10000).
# METRICS_COLLECT_INTERVAL_MS=10000
