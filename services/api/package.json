{
    "name":  "@udehlabs/api",
    "version":  "0.6.0",
    "private":  true,
    "description":  "UdehLabs Phase 6 identity + persistence foundation",
    "license":  "UNLICENSED",
    "type":  "module",
    "scripts":  {
                    "build":  "tsc -p tsconfig.json \u0026\u0026 node scripts/copy-migrations.cjs",
                    "start":  "node --env-file-if-exists=.env dist/app/server.js",
                    "migrate":  "node --env-file-if-exists=.env dist/persistence/migrate.js",
                    "seed":  "node --env-file-if-exists=.env dist/app/seed.js",
                    "test:unit":  "node --test dist/tests/unit.test.js",
                    "test:integration":  "node --env-file-if-exists=.env --test dist/tests/integration.test.js",
                    "test:new":  "node --env-file-if-exists=.env --test --test-reporter=dot dist/tests/disposable-auth-fixture.test.js",
                    "test:all":  "node --env-file-if-exists=.env --test --test-reporter=dot dist/tests/*.test.js",
                    "test":  "node --env-file-if-exists=.env --test dist/tests/unit.test.js",
                    "typecheck":  "tsc --noEmit -p tsconfig.json",
                    "lint":  "node --check dist/app/server.js \u0026\u0026 echo lint-ok"
                },
    "dependencies":  {
                         "pg":  "^8.12.0"
                     },
    "devDependencies":  {
                            "@types/node":  "^22.7.0",
                            "@types/pg":  "^8.10.9",
                            "typescript":  "^5.6.2"
                        },
    "engines":  {
                    "node":  "\u003e=22"
                }
}